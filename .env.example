# ==============================================================================
# SECUREBANK — CONFIGURATION TEMPLATE (.env.example)
# Rename this file to .env or set environment variables in your operating system.
# NEVER commit production credentials, passwords, or private keys to git.
# ==============================================================================

# JDBC Connection URL
# For local MySQL 8.0+:
SECUREBANK_DB_URL=jdbc:mysql://localhost:3306/securebank_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata

# For embedded in-memory H2 (Zero-setup test mode):
# SECUREBANK_DB_URL=jdbc:h2:mem:securebank_db;MODE=MySQL;DATABASE_TO_LOWER=TRUE;DB_CLOSE_DELAY=-1

# Dedicated Application Database User (Do NOT use MySQL root in production)
SECUREBANK_DB_USER=securebank_app

# Database User Password
SECUREBANK_DB_PASS=ChangeThisSecurePassword123!

# Connection Pool Size (Optional)
SECUREBANK_DB_POOL_SIZE=10
